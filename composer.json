{
  "name": "site-only-chatbot/wordpress-plugin",
  "description": "WordPress site-grounded chatbot with PDF extraction",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "ext-iconv": "*",
    "ext-zlib": "*",
    "spatie/pdf-to-text": "^1.6",
    "smalot/pdfparser": "^2.13",
    "ext-mbstring": "*"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
